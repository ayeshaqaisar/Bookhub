{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": false,        
    "noImplicitAny": false,

    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": ["**/*.ts"]
}
